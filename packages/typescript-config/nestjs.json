{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "ignoreDeprecations": "5.0",
    "outDir": "./dist",
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false
  }
}
